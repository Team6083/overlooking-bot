# ---------- Required ----------
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-
SLACK_USER_TOKEN=xoxp-
# Must include the database name.
DB_CONN_STRING=mongodb://localhost:27017/overlooking
# Shared files are saved to <prefix>/<user>/<file id>/<name>.
SLACK_FILE_SAVE_PREFIX=./files

# ---------- General ----------
# LOG_LEVEL=info
AUTO_JOIN_CHANNELS=false

# ---------- Reaction Check ----------
USE_REACTION_CHECK=false
# Comma-separated user IDs to leave out of the check.
REACTION_USER_IGN_LIST=

# ---------- Google Drive compliance check ----------
USE_GOOGLE_DRIVE_CHECK=false
# One of these two is required when the check is on.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Comma-separated IDs. Leave both empty to skip the location check.
GOOGLE_DRIVE_ALLOWED_SHARED_DRIVE_IDS=
GOOGLE_DRIVE_ALLOWED_FOLDER_IDS=
GOOGLE_DRIVE_ALLOW_DOMAIN_SHARING=false
GOOGLE_DRIVE_REPORT_ONLY_VIOLATIONS=true
GOOGLE_DRIVE_AUDIT_CHANNEL=

# ---------- REST API (enabled when API_KEY is set) ----------
API_KEY=
API_PORT=3001

# ---------- Webhook relay ----------
USE_WEBHOOK_RELAY=false
# Public HTTPS URL that reaches WEBHOOK_PORT; required when the relay is on.
WEBHOOK_PUBLIC_BASE_URL=
# Must differ from API_PORT.
WEBHOOK_PORT=3000
